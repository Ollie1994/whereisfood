# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (Protomaps PMTiles — no API key needed). Required: the map draws nothing
# without it. In dev, /gothenburg.pmtiles serves public/gothenburg.pmtiles; before
# launch the file moves to Cloudflare R2 (Phase 8).
#
# ⚠ public/*.pmtiles is gitignored, so a fresh clone does NOT have the file and the
# map shows an empty basemap. Cut a Gothenburg extract with the pmtiles CLI from a
# Protomaps daily build; README.md "Get the map tiles" has the exact command.
NEXT_PUBLIC_PMTILES_URL=/gothenburg.pmtiles
