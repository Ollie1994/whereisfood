# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: every .env* file is ignored except .env.example, which holds names only
# (CLAUDE.md, Hard Rules, "Secrets"). No slash, so it matches in every folder.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
Thumbs.db

# Map tiles (served from public/ locally; hosted externally in production)
public/*.pmtiles

# MapLibre worker, copied from node_modules by `predev`/`prebuild`
# (scripts/copy-maplibre-worker.mjs)
/public/maplibre/

# Supabase
supabase/.branches
supabase/.temp

# Claude
.claude/settings.local.json
