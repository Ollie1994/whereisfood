#!/bin/sh
# Refuses a commit whose message holds a value Gitleaks' rules flag (IS #292). The
# pre-commit hook scans only the staged changes, and `gitleaks git` reads patches, not
# messages: in a scratch repo it missed a flagged message that `gitleaks stdin` found.
# The Gitleaks call and checks: `gitleaks-common.sh`.
#
# Run: `git commit` (with `-m` or an editor), `--amend`, `git merge -m`, and `rebase -i`'s
# reword each refused a flagged message here (exit 1). Not run: `cherry-pick` (`-e`
# too), `am`, a plain `rebase` and `commit --no-verify` each committed one (exit 0).
# All probed in scratch repos. A clone without `core.hooksPath` doesn't run it either.
#
# Under `git commit -v` the message file also holds the staged diff after git's scissors
# line (`# ------------------------ >8 ------------------------`), so scanning it all
# refused a commit that removes a flagged line, for its `-` line. Git drops that part
# under `-v` (and with `commit.verbose` set, even under `-m`), but not under a plain
# `-m`, where a value after such a line was committed. So after a scissors line only the
# diff's own lines are dropped (the list in the sed below); the rest is scanned.
# Not scanned, then: a message line after a scissors line that starts with `+`, `-`, a
# space or `\`, or with one of the diff header words below.
# Not recognised as a scissors line, so the whole file is scanned (a commit removing a
# flagged line is refused, not let through): one with a comment character other than
# `#` (`core.commentChar`). `\r` in the pattern is GNU sed's; only Git for Windows' GNU
# sed was probed, so a CR-ended scissors line under another sed may not be recognised.

case $0 in */*) here=${0%/*} ;; *) here=. ;; esac
if [ ! -r "$here/gitleaks-common.sh" ]; then
  echo "commit-msg: can't read gitleaks-common.sh beside the hook. Commit refused." >&2
  exit 1
fi
. "$here/gitleaks-common.sh"
gitleaks_preflight commit-msg

if [ ! -r "$1" ]; then
  echo "commit-msg: can't read the message file \"$1\". Commit refused." >&2
  exit 1
fi

cut='^# -\{24\} >8 -\{24\}\r\{0,1\}$'
if ! msg=$(sed -e "/$cut/,\$ {
  /$cut/d
  /^diff --git /d
  /^index /d
  /^@@/d
  /^[-+ ]/d
  /^\\\\/d
  /^new file mode /d
  /^deleted file mode /d
  /^old mode /d
  /^new mode /d
  /^similarity index /d
  /^dissimilarity index /d
  /^rename from /d
  /^rename to /d
  /^copy from /d
  /^copy to /d
  /^Binary files /d
}" "$1"); then
  echo "commit-msg: couldn't read the message. Commit refused." >&2
  exit 1
fi

printf '%s\n' "$msg" | run_gitleaks stdin
